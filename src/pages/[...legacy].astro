---
import type { CollectionEntry } from "astro:content";
import { SITE } from "../config";
import { getPublishedPosts, legacyPostUrl, postUrl } from "../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.flatMap((post) => {
    const path = legacyPostUrl(post.id);
    return path ? [{ params: { legacy: path.slice(1, -1) }, props: { post } }] : [];
  });
}

const redirectTo = postUrl((Astro.props as { post: CollectionEntry<"posts"> }).post.id);
const canonicalUrl = new URL(redirectTo, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalUrl} />
    <title>Redirecting…</title>
  </head>
  <body><a href={redirectTo}>Taking you to the new post page…</a></body>
</html>
