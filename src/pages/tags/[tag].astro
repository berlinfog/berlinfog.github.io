---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPublishedPosts, postUrl } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props as { tag: string; posts: Awaited<ReturnType<typeof getPublishedPosts>> };
---
<BaseLayout title={`Tag: ${tag}`}><section class="page-intro"><p class="eyebrow">TAG ARCHIVE</p><h1>#{tag}</h1><p>{posts.length} related {posts.length === 1 ? "post" : "posts"}</p></section><div class="archive-list">{posts.map((post) => <article><time>{formatDate(post.data.date)}</time><div><h2><a href={postUrl(post.id)}>{post.data.title}</a></h2></div><a class="arrow" href={postUrl(post.id)}>↗</a></article>)}</div></BaseLayout>
