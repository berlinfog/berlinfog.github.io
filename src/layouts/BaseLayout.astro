---
import "../styles/global.css";
import { SITE, SKINS } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
---

<!doctype html>
<html lang="en" data-skin={SITE.skin}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f7ff" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E✦%3C/text%3E%3C/svg%3E" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="sky" aria-hidden="true"><i></i><i></i><i></i></div>
    <header class="site-header container">
      <a class="brand" href="/" aria-label="Back to home"><span>BF</span>{SITE.title}</a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
      </nav>
      <div class="controls">
        <button class="icon-button" data-theme-toggle aria-label="Toggle light and dark mode">◐</button>
        <div class="skin-picker">
          <button class="icon-button" data-skin-toggle aria-label="Change colour theme">✦</button>
          <div class="skin-menu" aria-label="Choose a colour theme">
            {Object.entries(SKINS).map(([key, skin]) => <button data-skin={key}><span style={`--swatch:${skin.color}`}></span>{skin.label}</button>)}
          </div>
        </div>
      </div>
    </header>
    <main class="container"><slot /></main>
    <footer class="container site-footer">
      <span>© {new Date().getFullYear()} {SITE.name}</span>
      <span>Astro · Markdown</span>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const storage = window.localStorage;
      const savedTheme = storage.getItem("theme");
      const savedSkin = storage.getItem("skin");
      if (savedTheme) root.dataset.theme = savedTheme;
      if (savedSkin) root.dataset.skin = savedSkin;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        storage.setItem("theme", next);
      });
      const picker = document.querySelector(".skin-picker");
      document.querySelector("[data-skin-toggle]")?.addEventListener("click", () => picker?.classList.toggle("is-open"));
      document.querySelectorAll("[data-skin]").forEach((button) => button.addEventListener("click", () => {
        const skin = button.dataset.skin;
        if (skin) { root.dataset.skin = skin; storage.setItem("skin", skin); }
        picker?.classList.remove("is-open");
      }));
    </script>
  </body>
</html>
